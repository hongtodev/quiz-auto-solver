# SQL Server Configuration
DB_SERVER=localhost\\SQLEXPRESS
DB_NAME=QuizAnswerVault
# Authentication type: 'windows' (Windows Auth - mặc định) hoặc 'sql' (SQL Server Auth)
DB_AUTH_TYPE=windows
# Chỉ cần nếu DB_AUTH_TYPE=sql
DB_USER=sa
DB_PASSWORD=YourPassword
DB_ENCRYPT=false

# AI Configuration (Extension Chrome)
# Provider: 'ollama' (local, free, recommended) hoặc 'openai' (cloud)
AI_PROVIDER=ollama
OLLAMA_ENDPOINT=http://localhost:11434/api/chat
OLLAMA_MODEL=mistral
# Chỉ cần nếu AI_PROVIDER=openai hoặc làm fallback
OPENAI_API_KEY=sk-your-api-key-here

# Server Configuration
PORT=3000
NODE_ENV=development

# Extension Communication
EXTENSION_ORIGIN=chrome-extension://*
